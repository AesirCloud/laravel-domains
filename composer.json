{
  "name": "aesircloud/laravel-domains",
  "description": "A Laravel package for rapid domain driven development.",
  "keywords": [
    "AesirCloud",
    "laravel",
    "domain",
    "domain driven design",
    "laravel domains"
  ],
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Greg Upton",
      "email": "greg@aesircloud.com",
      "homepage": "https://aesircloud.com",
      "role": "Developer"
    }
  ],
  "homepage": "https://github.com/AesirCloud/laravel-domains",
  "autoload": {
    "psr-4": {
      "AesirCloud\\LaravelDomains\\": "src/",
      "AesirCloud\\LaravelDomains\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "AesirCloud\\LaravelDomains\\Providers\\DomainServiceProvider"
      ]
    }
  },
  "require": {
    "php": "^8.3",
    "illuminate/console": "^13.30",
    "illuminate/support": "^13.30",
    "laravel/framework": "^13.30",
    "spatie/laravel-data": "^4.13",
    "aesircloud/sluggable": "^1.3",
    "aesircloud/laravel-actions": "^1.3"
  },
  "require-dev": {
    "pestphp/pest": "^4.0 || ^5.3",
    "orchestra/testbench": "^11.0"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
